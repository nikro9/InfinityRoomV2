# ==========================================
# InfinityRoomV2 - Environment Variables
# ==========================================

# --- AI APIs ---
GOOGLE_API_KEY="your_google_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
TOGETHER_API_KEY="your_together_api_key_here"

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# --- Databases ---

# Upstash Redis (For messaging and fast key-value storage)
REDIS_URL="rediss://default:your_redis_token@your-redis-endpoint.upstash.io:6379"

# --- Configuration ---
# Set to "true" to run background trading workers inside the API process
ENABLE_WORKERS="true"

# Frontend URL (For CORS configuration)
FRONTEND_URL="https://your-frontend-url.netlify.app"
